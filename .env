# ══════════════════════════════════════════════
# MT5 SMC Scalper Bot — Environment Variables
# Copy to .env và điền thông tin thực
# ══════════════════════════════════════════════

# ─── DATA SOURCE ──────────────────────────────
# Auto-detect theo OS: Windows→MT5, Mac/Linux→YFINANCE
# Đặt tường minh nếu cần override:
# DATA_SOURCE=YFINANCE

# ─── DATA PROVIDER (Mac/Linux only) ───────────
# DUKASCOPY = bid price, chất lượng cao, miễn phí, không cần API key (recommended)
# TWELVEDATA = cần TWELVE_DATA_API_KEY bên dưới
# (bỏ trống = tự chọn: Twelve Data nếu có key, yokhông thì yfinance)
DATA_PROVIDER=DUKASCOPY

# ─── TRADING PROFILE ──────────────────────────
# CONSERVATIVE | MODERATE | AGGRESSIVE
TRADING_PROFILE=AGGRESSIVE

# ─── METATRADER 5 (Windows VPS only) ──────────
# MT5 terminal phải đang chạy, API enabled:
# Tools → Options → Expert Advisors → Allow DLL imports
MT5_LOGIN=52926435
MT5_PASSWORD=xPi!nNN78&azOP
MT5_SERVER=ICMarketsSC-Demo
# MT5_PATH=C:\Program Files\MetaTrader 5\terminal64.exe  # chỉ cần nếu không tìm được tự động
MT5_DEMO_MODE=true   # false = live account

# ─── SYMBOL MAP (broker-specific suffix) ──────
# Một số broker dùng suffix: EURUSD.raw, XAUUSDm, XAUUSD.stp ...
# Để trống = dùng tên chuẩn
# MT5_SYM_EURUSD=EURUSD
# MT5_SYM_GBPUSD=GBPUSD
# MT5_SYM_XAUUSD=XAUUSD
# MT5_SYM_USDJPY=USDJPY

# ─── POLLING ──────────────────────────────────
MT5_POLL_INTERVAL=5    # giây, Windows; Mac dùng tối thiểu 60

# ─── DATABASE (PostgreSQL) ────────────────────
# Mac:  brew install postgresql@16 && brew services start postgresql@16
#       createuser -s postgres  (nếu chưa có)
#       createdb mt5_scalper_db
# Win:  https://www.postgresql.org/download/windows/
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=mt5_scalper_db
DB_USER=ngocdang
DB_PASSWORD=Ngocdang123

# ─── TWELVE DATA (15m historical, 2 năm) ─────
# Account: thichchoi*****@gmail.com
TWELVE_DATA_API_KEY=38fa693f4a334295bb2020f04b67f997

# ─── TELEGRAM ALERTS ──────────────────────────
TELEGRAM_BOT_TOKEN=8821195660:AAFg4DyaWQhJNztpE6elW06A91_34xz50k4
TELEGRAM_CHAT_ID=7457950702

# ─── WEB DASHBOARD ────────────────────────────
DASHBOARD_USER=admin
DASHBOARD_PASS=changeme_secure_password

# ─── STRATEGY TUNING (optional) ───────────────
ENTRY_TIMEFRAME=5m
                             # 15m OK on Windows MT5
LIMIT_ORDER_TIMEOUT_CANDLES=5   # 0 = GTC (không timeout)
SESSION_FILTER_ENABLED=true

DATA_SOURCE=MT5

MT5_ENABLED=true
